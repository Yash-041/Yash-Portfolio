# Copy to .env.local for local development. Set the same variables in Vercel/Netlify for production.

# Contact form: create a form at https://formspree.io and paste its endpoint.
# Without it, the form falls back to opening a prefilled email draft.
VITE_FORMSPREE_ENDPOINT=

# "Ask about Yash" AI chat (server-side only — no VITE_ prefix, so it never reaches the browser).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b. Available models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Optional: point the chat widget at a different endpoint (defaults to /api/chat).
VITE_CHAT_ENDPOINT=
